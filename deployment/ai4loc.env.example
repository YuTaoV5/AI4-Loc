# Copy outside the repository to ~/.config/ai4loc.env (chmod 600).
# Fill the exact installed model name before starting.
KERNEL_AGENT_MODEL=
KERNEL_AGENT_BASE_URL=http://127.0.0.1:11434
KERNEL_AGENT_TRANSPORT=ollama-native
PORT=8787
# Optional paths must be absolute; systemd EnvironmentFile does not expand $HOME.
# KERNEL_BENCHMARK_DIR=/home/ai4loc/ai4loc/data/datasets/openharmony-lkdtm-lab-v2
# KERNEL_VERIFIED_SOURCE_REGISTRY=/home/ai4loc/private/verified-source.json
# KERNEL_ROUTER_BASE_URL=http://127.0.0.1:30000/v1
# KERNEL_ROUTER_MODEL=<installed-router-model>
# Strict one-click Agent suite (different from community browser fixtures).
# KERNEL_BENCHMARK_DATASET=/home/ai4loc/private/evaluation-datasets/stability-v1
# KERNEL_BENCHMARK_HARDWARE_ID=<GPU-driver-model-checkpoint-config-revision>
# KERNEL_DECISION_BASE_URL=http://127.0.0.1:30000
# KERNEL_DECISION_API=decisions
